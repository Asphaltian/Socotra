@inherits Panel

<root class="button @(Selected ? "selected" : "")">
    <label class="text">@Text</label>
    @ChildContent
</root>

@code {
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public bool Selected { get; set; }
    [Parameter] public Action? OnPressed { get; set; }

    protected override void OnClick(MousePanelEvent e) => OnPressed?.Invoke();
}
